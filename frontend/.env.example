# Local development configuration (specs/integration/frontend-backend.md).
# Copy to .env to override defaults; .env is gitignored and must never be committed.

# Implementation behind the DroneService abstraction.
#   api  (default) — real calls to the ASP.NET Core backend (run it first,
#                    e.g. `docker compose up` or `dotnet run`).
#   mock           — the Phase 1 simulator for backend-less UI development;
#                    also restores the mock scenarios panel.
VITE_DRONE_SERVICE=api

# Backend base URL used in api mode
# (DroneControl API host port from launchSettings / docker compose mapping).
VITE_API_BASE_URL=http://localhost:5080
