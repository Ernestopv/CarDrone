# Production build (vite build): the app is served same-origin by the frontend
# nginx, which proxies /api/ and /camera/. An EMPTY base makes every request
# relative, so no host or port is ever baked into the bundle
# (specs/integration/frontend-backend.md). A real process environment variable
# (for example the Docker build arg) still overrides this file. Local
# `vite dev` does not load this file and keeps the http://localhost:5080
# default documented in .env.example.
VITE_API_BASE_URL=
