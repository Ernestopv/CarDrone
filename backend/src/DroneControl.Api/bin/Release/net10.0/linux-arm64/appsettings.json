{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Safety": {
    "CommandTimeoutMilliseconds": 2000,
    "StopTimeoutMilliseconds": 1000,
    "StopRetryCount": 1,
    "StopRetryDelayMilliseconds": 100,
    "RecoveryRetryCount": 1,
    "RecoveryRetryDelayMilliseconds": 100,
    "ExternalAbruptFailureProtectionVerified": false
  },
  "GPIO": {
    "Pin1": 23,
    "Pin2": 24,
    "Pin3": 21,
    "Pin4": 20,
    "PWM1": 12,
    "PWM2": 13
  },
  "Raspberry": {
    "GPIO": {
      "ChipPath": "/dev/gpiochip0"
    }
  },
  "AllowedHosts": "*"
}
