# Pi-only Compose configuration (Task 34; specs/docker/unified-compose.md).
# HOW TO USE: read docs/RUNBOOK-PI.md first. Copy to the project root as
# `.env`, complete ONLY the operator fields marked below (from the target
# discovery probe evidence), and never invent values.
# COMPOSE_FILE is interpreted with Linux path-list syntax on Raspberry Pi OS.
# The merged Pi overlay changes the existing `backend` service and reserves an
# `ustreamer` device seam; it is not a second backend and invents no paths.
COMPOSE_FILE=docker-compose.yml:docker-compose.raspberry.yml

# Hardware runtime. `real` actuates GPIO/PWM; `dry-run` runs the same flow with
# every operation logged and suppressed (bench-safe, no physical output).
# On a non-linux/arm64 host the backend aborts loudly (D5) — never a fallback.
HARDWARE_MODE=real
# HARDWARE_MODE=dry-run

# Camera runtime: real stream. The `camera` compose profile (reserved by Task
# 31, service owned by Task 32) is enabled here so the literal `docker compose
# up` also starts uStreamer. PC mode has no .env and no camera profile.
CAMERA_MODE=ustreamer
COMPOSE_PROFILES=camera
# Backend probe reaches the same-origin /camera/ through the frontend nginx
# (compose-internal DNS; Task 31 value form).
CAMERA_PROBE_URL=http://frontend/camera/
# Frontend nginx passes the MJPEG stream through this compose-internal URL
# (Task 32 value); it must match uStreamer's internal port 8080 and MJPEG path.
CAMERA_PROXY_TARGET=http://ustreamer:8080/stream

# WebRTC (low latency) media server (go2rtc). go2rtc runs with host networking
# so WebRTC media is reachable at the Pi's real LAN IP; the frontend nginx
# proxies the SDP signaling at /go2rtc/ to this API through the Docker host
# gateway. The browser <video> is primary; the /camera/ MJPEG above stays as the
# automatic fallback. Empty = no WebRTC (MJPEG only).
GO2RTC_API_TARGET=http://host.docker.internal:1984
# Optional camera tuning (uStreamer service env). The attached camera offers
# MJPEG 1280x720 up to 30 fps; the design default is 15. Uncomment to raise it.
# CAMERA_FPS=30
# CAMERA_RESOLUTION=1280x720
# CAMERA_FORMAT=MJPEG

# Keep false until the external abrupt-failure mechanism has actually been
# verified on the target Pi (mock/build checks are not that verification).
SAFETY_EXTERNAL_FAILURE_PROTECTION_VERIFIED=false

# --- Real GPIO/PWM operator values (HARDWARE_MODE=real) -----------------------
# Fill ONLY from target evidence (docs/hardware/raspberry-pi-inventory.md,
# "Operator-supplied runtime values"). No value here is invented by the repo.
GPIO_DEVICE=/dev/gpiochip0
GPIO_GID=997
# GPIO_GID=997 is the recorded target evidence: host group `gpio:x:997:` with a
# udev rule giving /dev/gpiochip0 mode 0660 (see the inventory). Change only if
# the target changes.
# PWM speed: the chip tree is bind-mounted into the backend (see the Pi overlay)
# and the container can write it. Chip path + channel mapping from target
# evidence; the asserted duty envelope lives in ./pwm.env (PwmMapping__*).
PWM_CHIP_PATH=/sys/class/pwm/pwmchip0
PWM_CHANNEL_12=0
PWM_CHANNEL_13=1