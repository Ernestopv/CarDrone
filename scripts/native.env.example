# CarDrone — variables para el arranque NATIVO del stack (sin Docker).
# Copia a native.env y ajusta. El script run-native-pi.sh las exporta al .NET.

# --- Modo de hardware (real=actúa; dry-run=solo registra; mock=simulado) ---
HARDWARE_MODE=real
# Para D7 (aserción de banco; ruedas levantadas): descomenta
# Safety__ExternalAbruptFailureProtectionVerified=true

# --- GPIO real ---
GPIO_DEVICE=/dev/gpiochip0
# ENA/ENB (L298N): si no llevan puente físico, retén estos pines en ALTO
# mientras el stack corre (separa por comas). Ej.: 12,13 = PWM1,PWM2.
# MOTOR_ENABLE_PINS=12,13

# --- Cámara ---
# 'ustreamer' arranca uStreamer nativo y el probe usa http://127.0.0.1:<HTTP_PORT>/camera/
# 'mock' deja la cámara simulada (sin uStreamer).
CAMERA_MODE=ustreamer
CAMERA_DEVICE=/dev/video0
CAMERA_FORMAT=MJPEG
CAMERA_RESOLUTION=640x480
CAMERA_FPS=30
CAMERA_QUALITY=80
# Fuente del vídeo WebRTC (go2rtc):
#   ustreamer = WebRTC desde el MJPEG de uStreamer (mantiene el respaldo /camera/)
#   device    = WebRTC directo desde /dev/video0 (mínima latencia; sin respaldo
#               MJPEG, porque la cámara es exclusiva y uStreamer no puede correr
#               a la vez). El probe del backend apunta a /go2rtc/api/streams.
CAMERA_SOURCE=ustreamer
# Buffers/workers de uStreamer: 2/2 da los 30 fps de esta cámara (con 1 baja a 15).
CAMERA_BUFFERS=2
CAMERA_WORKERS=2
# WebRTC (go2rtc). WEBRTC_ENABLED=0 lo desactiva (queda solo MJPEG).
WEBRTC_ENABLED=1
GO2RTC_API_PORT=1984

# --- Puertos/paths ---
HTTP_PORT=8081
BACKEND_PORT=5080
USTREAMER_PORT=8080
WWW_ROOT=/var/www/cardrone

# --- (Opcional) velocidad PWM: rellena pwm.env con PwmMapping__... ---
# La velocidad real requiere (a) PWM enrutado a GPIO12/13 en el device-tree y
# (b) escribir /sys/class/pwm (nativo con root). Ver scripts/README o el runbook.