# CarDrone — variables para el arranque NATIVO del stack (sin Docker).
# Copia a native.env y ajusta. El script run-native-pi.sh las exporta al .NET.

# --- Modo de hardware (real=actúa; dry-run=solo registra; mock=simulado) ---
HARDWARE_MODE=real
# Para D7 (aserción de banco; ruedas levantadas): descomenta
# Safety__ExternalAbruptFailureProtectionVerified=true

# --- GPIO real ---
GPIO_DEVICE=/dev/gpiochip0

# --- Cámara ---
# 'ustreamer' arranca uStreamer nativo y el probe usa http://127.0.0.1:<HTTP_PORT>/camera/
# 'mock' deja la cámara simulada (sin uStreamer).
CAMERA_MODE=ustreamer
CAMERA_DEVICE=/dev/video0
CAMERA_FORMAT=MJPEG
CAMERA_RESOLUTION=1280x720
CAMERA_FPS=15
CAMERA_QUALITY=80

# --- Puertos/paths ---
HTTP_PORT=8081
BACKEND_PORT=5080
USTREAMER_PORT=8080
WWW_ROOT=/var/www/cardrone

# --- (Opcional) velocidad PWM: rellena pwm.env con PwmMapping__... ---
# La velocidad real requiere (a) PWM enrutado a GPIO12/13 en el device-tree y
# (b) escribir /sys/class/pwm (nativo con root). Ver scripts/README o el runbook.