# CarDrone — operator battery configuration for the NATIVE launcher (Task 41;
# specs/hardware/battery-monitoring.md).
#
# Copy to `battery.env` in the project root on the Pi to enable
# BATTERY_MODE=ina219 (run-native-pi.sh sources battery.env like motor.env /
# pwm.env). Without this file the launcher defaults to BATTERY_MODE=mock
# (deterministic simulated reading, no sensor touched).
#
# Values are the target evidence recorded in
# docs/hardware/raspberry-pi-inventory.md (section "I2C"): INA219 at 0x42,
# pack measured 6.668 V on 2026-10-06. Do not invent values.
BATTERY_MODE=ina219
I2C_DEVICE=/dev/i2c-1
BATTERY_I2C_ADDRESS=0x42
BATTERY_FULL_VOLTAGE=8.4
BATTERY_EMPTY_VOLTAGE=6.0
# Shunt resistance of the INA219 board (operator-confirmed R100 = 0.1 ohm).
BATTERY_SHUNT_OHMS=0.1
# Presentation thresholds (0-100; optional, defaults 20/10).
# BATTERY_LOW_PERCENT=20
# BATTERY_CRITICAL_PERCENT=10